namespace ams::mitm::lanywhere {
/* ACTUAL_ROUTES */
static GameRoute current{};
constexpr int CodeLength=6,GroupPageEnd=-1;
struct MatchJoinAttempt {u8 ticket[16];};
enum class MatchScanResult {Manual,Empty,Assigned};
enum class LdnMsg {Scan};constexpr u8 AllMembers=255;
int ResultRelayFailed(){return 450;}
bool CaptureGameRoute(GameRoute*out){*out=current;return true;}
bool GameRouteStillCurrent(const GameRoute&r){return r.room_epoch==current.room_epoch&&r.discovery.ipv4==current.discovery.ipv4&&r.discovery.port==current.discovery.port&&!std::strcmp(r.discovery.provider,current.discovery.provider);}
void ReportGameNetworkError(bool unavailable){error_kind=unavailable?1:2;}
void ReportGameRouteChanged(){error_kind=3;}
void Log(const char*,...){}
/* ACTUAL_CACHE */
bool MatchArmed(){return quick;}void CancelMatch(){quick=false;}
MatchScanResult ScanMatch(const ldn::ScanFilter&f,ldn::NetworkInfo*,const DiscoveryRoute*){++match_calls;seen_scan=f.networkId.intentId.localCommunicationId;return quick?MatchScanResult::Empty:MatchScanResult::Manual;}
bool InRoom(){return current.room_epoch!=0;}
bool SendControl(u8,LdnMsg,const void*,size_t){++effects;return true;}
int FindGroupsFilteredPage(const ldn::ScanFilter&f,u32 offset,u32*next,void(*found)(const char*,const void*,void*),void*user,const DiscoveryRoute*r){++effects;++page_calls;assert(offset==0);assert(!std::strcmp(r->provider,current.discovery.provider));seen_scan=f.networkId.intentId.localCommunicationId;*next=UINT32_MAX;if(have_offer)found("ABCDEF",&offered,user);return have_offer?1:0;}
Result CreateRoom(u64 id,const DiscoveryRoute*r,GameRoute*joined){++effects;assert(!std::strcmp(r->provider,current.discovery.provider));seen_create=id;current.room_epoch=1;current.room_token=42;*joined=current;if(create_race){current.room_epoch++;if(create_race==2)current.room_token++;}return 0;}
Result JoinRoom(const char*,u64 id,const DiscoveryRoute*r,GameRoute*joined){++effects;assert(!std::strcmp(r->provider,current.discovery.provider));seen_join=id;current.room_epoch=1;current.room_token=42;*joined=current;return 0;}
Result JoinMatch(const ldn::NetworkInfo&info,u16,MatchJoinAttempt*){++effects;seen_join=info.networkId.intentId.localCommunicationId;current.room_epoch=1;return 0;}
bool FinishMatch(const MatchJoinAttempt&,bool){return true;}
void LeaveRoom(){++leaves;current.room_epoch=current.room_token=0;}
void LeaveGameRoom(const GameRoute&owned){if(current.room_token==owned.room_token)LeaveRoom();}
void LeaveMatchRoom(const MatchJoinAttempt&){LeaveRoom();}
constexpr size_t MatchFilterSize=96;constexpr u32 KnownScanFlags=0x37;
void put64(u8*p,u64 n){gi_put64(p,n);}void put32(u8*p,u32 n){gi_put32(p,n);}void put16(u8*p,u16 n){p[0]=n;p[1]=n>>8;}
static int identity_lookups=0;
GameCacheResult GameIdentityCacheLookup(u64,u64,GameIdentity*out){++identity_lookups;out->application_id=42;std::strcpy(out->english,"Untrusted sentinel match");std::strcpy(out->chinese,"本地缓存");return GameCacheFound;}
