using namespace ams::mitm;using namespace ams::mitm::ldn;
GameCacheRecord make_record(u64 program,u64 first){GameCacheRecord r{};r.application_id=program;for(auto &id:r.local_communication_ids)id=program;r.local_communication_ids[0]=first;std::strcpy(r.names.english,"Test title");std::strcpy(r.names.chinese,"测试标题");return r;}
void encode(std::vector<GameCacheRecord> records){cache_bytes.assign(64+records.size()*328,0);game_cache_header(cache_bytes.data(),records.size(),1);for(size_t i=0;i<records.size();i++)game_cache_encode_record(&records[i],cache_bytes.data()+64+i*328);GameIdentitySha256 h;gi_sha256_init(&h);gi_sha256_update(&h,cache_bytes.data(),32);gi_sha256_update(&h,cache_bytes.data()+64,cache_bytes.size()-64);gi_sha256_final(&h,cache_bytes.data()+32);}
void reset(const char*provider="self",bool active=false){effects=lookups=error_kind=match_calls=page_calls=create_race=leaves=physical_calls=physical_connects=0;cache_open=true;flip_route=quick=false;seen_create=seen_join=seen_scan=seen_connect=0;have_offer=false;offered=published={};lanywhere::current={};auto&r=lanywhere::current;r.discovery.ipv4=1;r.discovery.port=2;r.discovery.public_enabled=true;std::strcpy(r.discovery.provider,provider);r.room_epoch=active?9:0;r.room_token=active?33:0;}
int main(){
 constexpr u64 dying=0x01008c8012920000ULL,violet=0x01008f6008c5e000ULL,shared=0x0100a3d008c5c000ULL;
 auto dr=make_record(dying,dying),vr=make_record(violet,shared);SecurityConfig sec{};UserConfig user{};NetworkConfig cfg{};cfg.intentId.localCommunicationId=UINT64_MAX;cfg.intentId.sceneId=41;cfg.nodeCountMax=4;cfg.localCommunicationVersion=7;
 for(auto pair:{std::pair<u64,u64>{dying,dying},{violet,shared}}){reset();encode({dr,vr});LANDiscovery game;game.hostProgramId=pair.first;assert(game.createNetwork(&sec,&user,&cfg)==0);assert(seen_create==pair.second&&published.networkId.intentId.localCommunicationId==pair.second&&published.networkId.intentId.sceneId==41);assert(cfg.intentId.localCommunicationId==UINT64_MAX);assert(!std::memcmp(reinterpret_cast<u8*>(&published.networkId.intentId)+8,reinterpret_cast<u8*>(&cfg.intentId)+8,8));}
 for(const char*provider:{"lanywhere-public","lanplay-cn-jax"}){reset(provider);encode({dr,vr});LANDiscovery game;game.hostProgramId=violet;assert(game.createNetwork(&sec,&user,&cfg)==0);assert(seen_create==UINT64_MAX&&published.networkId.intentId.localCommunicationId==UINT64_MAX&&game.loggedCanonicalLcid==shared);}
 // Missing, corrupt, ambiguous, wrong exact ID, default0/defaultFFFF fail before any network side effect.
 for(int bad=0;bad<6;bad++){reset();auto rec=vr;if(bad==4)rec.local_communication_ids[0]=0;if(bad==5)rec.local_communication_ids[0]=UINT64_MAX;encode({rec});if(bad==0)cache_open=false;if(bad==1)cache_bytes[32]^=1;if(bad==2){auto other=vr;other.local_communication_ids[0]=dying;encode({vr,other});}LANDiscovery game;game.hostProgramId=bad==3?violet+1:violet;assert(game.createNetwork(&sec,&user,&cfg)!=0&&effects==0&&error_kind==1);ScanFilter f{};f.flag=1;f.networkId.intentId.localCommunicationId=UINT64_MAX;NetworkInfo out[8]{};u16 count=8;assert(game.scan(out,&count,f)!=0&&effects==0&&count==0);NetworkInfo n{};n.ldn.nodeCount=1;n.networkId.intentId.localCommunicationId=UINT64_MAX;assert(game.connect(&n,&user,7)!=0&&effects==0);}
 for(bool external:{false,true}){reset(external?"lanplay-cn-jax":"self");encode({dr,vr});LANDiscovery game;game.hostProgramId=violet;ScanFilter f{};f.flag=1|32;f.networkId.intentId.localCommunicationId=UINT64_MAX;f.networkId.intentId.sceneId=41;have_offer=true;offered.networkId.intentId=f.networkId.intentId;offered.networkId.intentId.localCommunicationId=external?UINT64_MAX:shared;offered.ldn.nodeCount=1;NetworkInfo out[8]{};u16 count=8;assert(game.scan(out,&count,f)==0&&count==1);assert(seen_scan==(external?UINT64_MAX:shared));assert(external?match_calls==0:match_calls==1);assert(game.connect(&out[0],&user,7)==0);assert(seen_join==(external?UINT64_MAX:shared)&&seen_connect==seen_join);}
 // An unfiltered scan neither looks up nor rewrites its unused sentinel field.
 reset();cache_open=false;LANDiscovery any;any.hostProgramId=violet;ScanFilter f{};f.networkId.intentId.localCommunicationId=UINT64_MAX;NetworkInfo out[8]{};u16 count=8;assert(any.scan(out,&count,f)==0&&lookups==0&&seen_scan==UINT64_MAX);
 // Existing private-room identity follows active provider without creating another room.
 reset("self",true);encode({vr});LANDiscovery private_game;private_game.hostProgramId=violet;assert(private_game.createNetwork(&sec,&user,&cfg)==0&&seen_create==0&&published.networkId.intentId.localCommunicationId==shared);
 // An App-selected active private room overrides this service's earlier public scan route.
 reset("lanplay-cn-jax");encode({vr});LANDiscovery old_scan;old_scan.hostProgramId=violet;have_offer=true;offered.ldn.nodeCount=1;offered.networkId.intentId.localCommunicationId=UINT64_MAX;ScanFilter sf{};sf.flag=1;sf.networkId.intentId.localCommunicationId=UINT64_MAX;count=8;assert(old_scan.scan(out,&count,sf)==0&&count==1);std::strcpy(lanywhere::current.discovery.provider,"self");lanywhere::current.room_epoch=8;lanywhere::current.room_token=77;seen_join=0;assert(old_scan.connect(&out[0],&user,7)==0&&seen_join==0&&seen_connect==shared);
 // Positive explicit alternate stays unchanged; an unauthorized explicit ID fails.
 reset();encode({vr});LANDiscovery explicit_game;explicit_game.hostProgramId=violet;cfg.intentId.localCommunicationId=violet;assert(explicit_game.createNetwork(&sec,&user,&cfg)==0&&seen_create==violet);
 reset();encode({vr});LANDiscovery denied;denied.hostProgramId=violet;cfg.intentId.localCommunicationId=dying;assert(denied.createNetwork(&sec,&user,&cfg)!=0&&effects==0&&error_kind==2);
 reset();cache_open=false;LANDiscovery explicit_missing;explicit_missing.hostProgramId=violet;cfg.intentId.localCommunicationId=violet;assert(explicit_missing.createNetwork(&sec,&user,&cfg)==0&&seen_create==violet);
 reset();encode({vr});LANDiscovery zero;zero.hostProgramId=violet;cfg.intentId.localCommunicationId=0;assert(zero.createNetwork(&sec,&user,&cfg)!=0&&effects==0&&error_kind==2);
 // Clean up only our auto-created room on a setup epoch change; retain a replacement room.
 for(int race:{1,2}){reset();encode({vr});create_race=race;LANDiscovery game;game.hostProgramId=violet;cfg.intentId.localCommunicationId=UINT64_MAX;assert(game.createNetwork(&sec,&user,&cfg)!=0&&!game.autoRoom&&error_kind==3);assert(leaves==(race==1?1:0));assert(race==1?!lanywhere::current.room_token:lanywhere::current.room_token==43);}
 u8 encoded[96]{};ScanFilter reserved{};reserved.flag=1;reserved.networkId.intentId.localCommunicationId=UINT64_MAX;assert(!lanywhere::MakeMatchFilter(reserved,encoded));reserved.networkId.intentId.localCommunicationId=shared;assert(lanywhere::MakeMatchFilter(reserved,encoded)&&gi_get64(encoded)==shared);
 lanywhere::GroupSummaryV2 unknown{};unknown.game_id=UINT64_MAX;lanywhere::AddCachedIdentity(unknown);
 assert(lanywhere::identity_lookups==0&&!unknown.metadata_flags&&!unknown.application_id&&!unknown.title_en[0]);
 unknown.game_id=shared;lanywhere::AddCachedIdentity(unknown);assert(lanywhere::identity_lookups==1&&unknown.metadata_flags==2);
 unknown.game_id=UINT64_MAX;std::strcpy(unknown.title_en,"Accurate host metadata");lanywhere::AddCachedIdentity(unknown);
 assert(lanywhere::identity_lookups==1&&!std::strcmp(unknown.title_en,"Accurate host metadata"));
 // Public mode is relay-only; no physical broadcast/fallback can mix wire identities.
 reset();encode({vr});LANDiscovery online;online.hostProgramId=violet;sf.flag=1;sf.networkId.intentId.localCommunicationId=UINT64_MAX;count=8;assert(online.scan(out,&count,sf)==0&&page_calls==1&&physical_calls==0);NetworkInfo unbound{};unbound.ldn.nodeCount=1;unbound.networkId.intentId.localCommunicationId=shared;assert(online.connect(&unbound,&user,7)!=0&&physical_connects==0);
 // With no active room and public mode off, all physical-LAN values stay raw,
 // even without a cache. No relay matching, lookup or room operation occurs.
 for(u64 raw:{UINT64_MAX,u64(0),u64(42)}){reset();cache_open=false;lanywhere::current.discovery.public_enabled=false;LANDiscovery local;local.hostProgramId=violet;cfg.intentId.localCommunicationId=raw;assert(local.createNetwork(&sec,&user,&cfg)==0&&published.networkId.intentId.localCommunicationId==raw&&seen_create==0&&lookups==0);local.state=CommState::Station;sf.flag=1;sf.networkId.intentId.localCommunicationId=raw;have_offer=true;offered.ldn.nodeCount=1;offered.networkId.intentId.localCommunicationId=raw;count=8;assert(local.scan(out,&count,sf)==0&&count==1&&physical_calls==1&&page_calls==0&&match_calls==0&&lookups==0);assert(local.connect(&out[0],&user,7)==0&&physical_connects==1&&seen_join==0&&lookups==0);}
 std::puts("Actual LCID entry/cache functions: create/scan/connect, target records, legacy wire, private room and six no-network failure cases passed");
}
