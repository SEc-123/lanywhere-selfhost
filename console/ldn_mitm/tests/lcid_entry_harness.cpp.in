struct MacLess {bool operator()(const MacAddress&a,const MacAddress&b)const{return std::memcmp(&a,&b,sizeof(a))<0;}};
struct FakeUdp {std::map<MacAddress,NetworkInfo,MacLess>scanResults;int sendBroadcast(LANPacketType){++effects;++physical_calls;if(have_offer)scanResults.emplace(offered.common.bssid,offered);return 0;}};
struct FakeTcp {int getFd(){return -1;}int sendPacket(LANPacketType,const void*,size_t){++effects;return 0;}};
class LANDiscovery {public:
 u64 hostProgramId=0,loggedWireLcid=0,loggedCanonicalLcid=0;bool loggedLcid=false;
 std::mutex scanResultsMutex;std::unique_ptr<FakeUdp>udp{new FakeUdp};std::unique_ptr<FakeTcp>tcp{new FakeTcp};
 struct PublicGroup{MacAddress bssid;char code[8];lanywhere::DiscoveryRoute route;};
 struct PublicScanContext{LANDiscovery*self;const ScanFilter*filter;lanywhere::DiscoveryRoute route;};
 std::array<PublicGroup,8>publicGroups{};size_t publicGroupCount=0;bool lastScanWasMatch=false,haveScanRoute=false,physicalScanActive=false,autoRoom=false,ownsMatchRoom=false;
 lanywhere::GameRoute lastScanRoute{},ownedGameRoute{};lanywhere::MatchJoinAttempt matchRoom{};
 CommState state=CommState::AccessPoint;int hostMember=-1;u16 listenPort=11452;NetworkInfo networkInfo{};
 Result resolveGameLcid(u64*,const lanywhere::GameRoute&);
 Result scan(NetworkInfo*,u16*,ScanFilter);static void onPublicGroup(const char*,const void*,void*);
 Result createNetwork(const SecurityConfig*,const UserConfig*,const NetworkConfig*);
 Result connect(const NetworkInfo*,UserConfig*,u16);
 Result connectRoom(const NetworkInfo*n,UserConfig*,u16,const lanywhere::MatchJoinAttempt* = nullptr,const lanywhere::GameRoute* = nullptr);
 void leaveAutoRoom();
 Result initTcp(bool){++effects;return 0;}Result initNetworkInfo(){networkInfo={};return 0;}
 Result getNodeInfo(NodeInfo*n,const UserConfig*,u16 version){n->localCommunicationVersion=version;return 0;}
 void setState(CommState s){state=s;}void initNodeStateChange(){}void updateNodes(){published=networkInfo;}
 void onDisconnectFromHost(){}
};
Result LANDiscovery::connectRoom(const NetworkInfo*n,UserConfig*,u16,const lanywhere::MatchJoinAttempt*,const lanywhere::GameRoute*r){++effects;seen_connect=n->networkId.intentId.localCommunicationId;connected_id=n->networkId;assert(r);return 0;}
