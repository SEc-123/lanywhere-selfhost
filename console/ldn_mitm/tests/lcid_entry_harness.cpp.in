static int effects=0,lookups=0,error_kind=0,match_calls=0,page_calls=0,create_race=0,leaves=0,physical_calls=0,physical_connects=0;
static bool cache_open=true,flip_route=false,quick=false;
static std::vector<u8> cache_bytes;
static u64 seen_create=0,seen_join=0,seen_scan=0,seen_connect=0;
static ams::mitm::ldn::NetworkInfo offered{},published{};
static ams::mitm::ldn::NetworkId connected_id{};
static bool have_offer=false;
namespace fs {using FileHandle=int;constexpr int OpenMode_Read=1;
Result OpenFile(int*f,const char*path,int){++lookups;assert(std::strcmp(path,GAME_CACHE_PATH)==0);*f=1;return cache_open?0:1;}
Result GetFileSize(s64*s,int){*s=cache_bytes.size();return 0;}
Result ReadFile(size_t*actual,int,s64 at,void*out,size_t n){if(at<0||size_t(at)>cache_bytes.size()||n>cache_bytes.size()-at)return 1;std::memcpy(out,cache_bytes.data()+at,n);*actual=n;return 0;}
void CloseFile(int){}
}
namespace util {void Strlcpy(char*out,const char*in,size_t n){std::snprintf(out,n,"%s",in);}}
