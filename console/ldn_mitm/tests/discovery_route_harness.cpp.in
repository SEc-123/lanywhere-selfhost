static Result Enter(u8,const u8*,size_t,const sockaddr_in *pinned,u8*,const u8*,const DiscoveryRoute *route,GameRoute *joined){
 enter_calls++;char provider[33]{};std::scoped_lock lock(g_lock);if(!ChooseEnterRoute(pinned,route,&entered_server,provider))return 1;entered_provider=provider;
 if(joined){*joined={};joined->discovery.ipv4=entered_server.sin_addr.s_addr;joined->discovery.port=entered_server.sin_port;util::Strlcpy(joined->discovery.provider,provider,sizeof(joined->discovery.provider));joined->room_token=91;joined->room_epoch=11;std::memcpy(joined->room_code,"ABC234",6);}return 0;
}
static void config(u16 port,const char *provider="lanywhere-public",bool pub=true){
 std::scoped_lock lock(g_lock);fs::files[ConfigPath]=std::make_shared<fs::Data>(fs::Data{"server=127.0.0.1\nport="+std::to_string(port)+"\nnetwork="+provider+"\npublic="+(pub?"1":"0")+"\napodo=Tester\n"});
 fs::denied=fs::fail_size=fs::short_read=false;
}
static void write_all(int fd,const u8 *p,size_t n){while(n){auto s=::send(fd,p,n,0);if(s<=0)return;p+=s;n-=s;}}
static void response(int fd,u8 type,const std::vector<u8> &body){u8 h[3];put16(h,body.size()+1);h[2]=type;write_all(fd,h,3);write_all(fd,body.data(),body.size());}
static bool receive(int fd,u8 &type,std::vector<u8> &body){u8 h[3];size_t n=0;while(n<3){auto got=::recv(fd,h+n,3-n,0);if(got<=0)return false;n+=got;}if(le16(h)<1)return false;type=h[2];body.resize(le16(h)-1);n=0;while(n<body.size()){auto got=::recv(fd,body.data()+n,body.size()-n,0);if(got<=0)return false;n+=got;}return true;}
class Relay {
 int listener;std::thread thread;std::atomic<bool>stop{false};
 public:
 std::atomic<int>connections{0},selects{0},finds{0},pages{0},filters{0};u16 port;u32 caps;bool reject_select=false,legacy_error=false;u8 select_error=7;int select_delay_ms=0;std::string expected_provider="lanywhere-public";u16 mutate_port=0;
 Relay(u32 bits):caps(bits){listener=::socket(AF_INET,SOCK_STREAM,0);assert(listener>=0);int one=1;::setsockopt(listener,SOL_SOCKET,SO_REUSEADDR,&one,sizeof(one));sockaddr_in a{};a.sin_family=AF_INET;a.sin_addr.s_addr=htonl(INADDR_LOOPBACK);assert(::bind(listener,(sockaddr*)&a,sizeof(a))==0);assert(::listen(listener,10)==0);socklen_t n=sizeof(a);assert(::getsockname(listener,(sockaddr*)&a,&n)==0);port=ntohs(a.sin_port);thread=std::thread([this]{run();});}
 ~Relay(){stop=true;::shutdown(listener,SHUT_RDWR);::close(listener);thread.join();}
 void run(){while(!stop){pollfd p{listener,POLLIN,0};if(::poll(&p,1,100)<=0)continue;int fd=::accept(listener,nullptr,nullptr);if(fd<0)continue;connections++;timeval t{2,0};::setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,&t,sizeof(t));u8 type;std::vector<u8>b;while(receive(fd,type,b)){
 if(type==T_SelectProvider){selects++;if(reject_select){response(fd,T_Error,{select_error});break;}assert(std::string(b.begin(),b.end())==expected_provider);if(select_delay_ms)std::this_thread::sleep_for(std::chrono::milliseconds(select_delay_ms));std::vector<u8>reply(5+b.size());put32(reply.data(),caps);reply[4]=b.size();std::memcpy(reply.data()+5,b.data(),b.size());response(fd,T_ProviderSelected,reply);}
 else if(type==T_Caps){if(mutate_port)config(mutate_port,"self",false);if(legacy_error)response(fd,T_Error,{4});else{std::vector<u8>reply(4);put32(reply.data(),caps);response(fd,T_CapsReply,reply);}}
 else if(type==T_Find||type==T_FindPage||type==T_FindFilter){u32 offset=0;if(type==T_Find){finds++;assert(b.size()==15);}else if(type==T_FindPage){pages++;assert(b.size()==12);offset=le32(b.data()+8);}else{filters++;assert(b.size()==101);offset=le32(b.data()+97);}const bool paged=type!=T_Find;size_t count=paged&&!offset?6:1;std::vector<u8>reply((paged?5:1)+count*GroupRecordSize);if(paged)put32(reply.data(),offset?GroupPageEnd:6);reply[paged?4:0]=count;for(size_t i=0;i<count;i++){size_t at=(paged?5:1)+i*GroupRecordSize;std::memcpy(reply.data()+at,"ABC234",6);put64(reply.data()+at+6,42);}response(fd,paged?T_Page:T_Groups,reply);}
 else assert(false);
 }::close(fd);}}
};
static int found_count=0;static void found(const char *code,const void *info,void*){assert(!std::strcmp(code,"ABC234"));assert(le64(static_cast<const u8*>(info))==42);found_count++;}
