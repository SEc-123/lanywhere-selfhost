 }
 config(other.port);for(int mode=0;mode<3;mode++){fs::denied=mode==0;fs::fail_size=mode==1;fs::short_read=mode==2;fs::writes=fs::creates=0;DiscoveryRoute route{};assert(!CaptureDiscoveryRoute(&route));char nick[32];Nickname(nick,sizeof(nick));assert(fs::writes==0&&fs::creates==0);checks++;}fs::denied=fs::fail_size=fs::short_read=false;
 config(other.port);fs::files["sdmc:/lanywhere/config.ini.bak"]=fs::files[ConfigPath];fs::files.erase(ConfigPath);DiscoveryRoute recovered{};assert(CaptureDiscoveryRoute(&recovered)&&std::string(recovered.provider)=="lanywhere-public");checks++;
