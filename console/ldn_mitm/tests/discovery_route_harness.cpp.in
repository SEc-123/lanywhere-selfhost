static int enter_calls=0;static sockaddr_in entered_server{};static std::string entered_provider;static bool matched=false;
static bool MatchArmed(){return matched;}static void CancelMatch(){matched=false;}
static Result Enter(u8,const u8*,size_t,const sockaddr_in *pinned=nullptr,u8 *error=nullptr,const u8 *owner=nullptr,const DiscoveryRoute *route=nullptr,GameRoute *joined=nullptr);
