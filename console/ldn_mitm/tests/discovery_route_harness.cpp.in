   fs::files[ConfigPath]=std::make_shared<fs::Data>(fs::Data{bad});fs::writes=fs::creates=0;assert(!CaptureDiscoveryRoute(&route));char nick[32];Nickname(nick,sizeof(nick));assert(fs::writes==0&&fs::creates==0&&std::string(nick)=="Player");checks++;
  }
  config(9);for(int mode=0;mode<3;mode++){fs::denied=mode==0;fs::fail_size=mode==1;fs::short_read=mode==2;fs::writes=fs::creates=0;assert(!CaptureDiscoveryRoute(&route));char nick[32];Nickname(nick,sizeof(nick));assert(fs::writes==0&&fs::creates==0);checks++;}fs::denied=fs::fail_size=fs::short_read=false;
  std::printf("Actual fixed-profile config/nickname slices: %u scenarios passed.\n",checks);return 0;
 }
 Relay other(2);
 for(u32 caps:{0u,2u,18u}){
  Relay relay(caps);relay.legacy_error=caps==0;relay.mutate_port=other.port;config(relay.port);fs::read_opens=0;found_count=0;ldn::ScanFilter filter;DiscoveryRoute route{};assert(CaptureDiscoveryRoute(&route));assert(fs::read_opens==1);u32 next=0;
  assert(FindGroupsFilteredPage(filter,0,&next,found,nullptr,&route)==(caps?6:1));assert(fs::read_opens==1);assert(relay.connections==1&&relay.selects==1&&other.connections==0);checks++;
  if(caps){assert(next==6);assert(FindGroupsFilteredPage(filter,6,&next,found,nullptr,&route)==1);assert(next==GroupPageEnd&&found_count==7&&fs::read_opens==1&&relay.connections==2&&other.connections==0);checks++;}
  assert((caps==0&&relay.finds==1)||(caps==2&&relay.pages==(caps?2:1))||(caps==18&&relay.filters==2));
 }
 {Relay relay(0);relay.legacy_error=true;relay.mutate_port=other.port;config(relay.port);fs::read_opens=0;u32 next=0;assert(FindGroupsPage(42,0,&next,found,nullptr,nullptr)==1);assert(fs::read_opens==1&&relay.connections==1&&other.connections==0);checks++;}
 {Relay relay(2);config(relay.port);fs::read_opens=0;ldn::ScanFilter f;f.valid=false;u32 next=0;assert(FindGroupsFilteredPage(f,0,&next,found,nullptr,nullptr)==6);assert(fs::read_opens==1&&relay.connections==1&&relay.pages==1);checks++;}
 {Relay relay(0);relay.reject_select=true;config(relay.port);fs::read_opens=0;u32 next=0;assert(FindGroupsPage(42,0,&next,found,nullptr,nullptr)==-1);assert(relay.finds==0&&relay.connections==1&&other.connections==0);checks++;}
 {Relay relay(0);config(relay.port);DiscoveryRoute route{};assert(CaptureDiscoveryRoute(&route));config(other.port,"self");enter_calls=0;assert(R_FAILED(JoinRoom("ABC234",42,&route)));assert(enter_calls==0&&std::string(g_error)=="Network changed; search again.");checks++;
  config(relay.port);enter_calls=0;assert(R_SUCCEEDED(JoinRoom("ABC234",42,&route)));assert(enter_calls==1&&entered_provider=="lanywhere-public"&&entered_server.sin_port==htons(relay.port));checks++;
  config(relay.port);GameRoute joined{};enter_calls=0;assert(R_SUCCEEDED(JoinRoom("ABC234",42,&route,&joined)));assert(enter_calls==1&&joined.room_token==91&&joined.room_epoch==11&&!std::strcmp(joined.room_code,"ABC234")&&std::string(joined.discovery.provider)=="lanywhere-public");checks++;
  config(other.port,"self");enter_calls=0;assert(R_SUCCEEDED(JoinRoom("ABC234",0,nullptr)));assert(enter_calls==1&&entered_provider=="self"&&entered_server.sin_port==htons(other.port));checks++;
  sockaddr_in fixed{};fixed.sin_family=AF_INET;fixed.sin_port=htons(relay.port);fixed.sin_addr.s_addr=htonl(INADDR_LOOPBACK);sockaddr_in chosen{};char provider[33]{};assert(ChooseEnterRoute(&fixed,nullptr,&chosen,provider)&&std::string(provider)=="self");assert(!ChooseEnterRoute(&fixed,&route,&chosen,provider));checks++;
 }
 {Relay relay(0);relay.expected_provider="lanplay-nl";relay.select_delay_ms=1200;config(relay.port,"lanplay-nl");DiscoveryRoute route{};assert(CaptureDiscoveryRoute(&route));sockaddr_in server{};char provider[33]{};assert(ResolveDiscoveryRoute(route,&server,provider));const char *error=nullptr;const int fd=ConnectServer(server,&error,100,provider);assert(fd>=0&&relay.connections==1&&relay.selects==1);::close(fd);checks++;}
 {Relay relay(0);relay.expected_provider="lanplay-nl";relay.select_delay_ms=700;config(relay.port,"lanplay-nl");
  DiscoveryRoute route{};assert(CaptureDiscoveryRoute(&route));sockaddr_in server{};char provider[33]{};assert(ResolveDiscoveryRoute(route,&server,provider));
  const char *error=nullptr;u32 status=ListStatusOk;
  const auto start=os::GetSystemTick();
  const u64 deadline=static_cast<u64>(start.ToTimeSpan().GetMilliSeconds())+200;
  assert(ConnectServer(server,&error,100,provider,&status,deadline)<0);
  const auto elapsed=(os::GetSystemTick()-start).ToTimeSpan().GetMilliSeconds();
