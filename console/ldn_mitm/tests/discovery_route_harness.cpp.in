 for(u8 error_code:{u8(7),u8(8),u8(4)}){Relay relay(0);relay.reject_select=true;relay.select_error=error_code;config(relay.port);DiscoveryRoute route{};assert(CaptureDiscoveryRoute(&route));sockaddr_in server{};char provider[33]{};assert(ResolveDiscoveryRoute(route,&server,provider));const char *error=nullptr;assert(ConnectServer(server,&error,100,provider)<0);assert(std::string(error)==(error_code==7?"External network is busy. Try later.":error_code==8?"Update relay to use external networks.":"External network is unavailable."));checks++;}
 for(const std::string &bad: {std::string("network=bogus\n"),std::string("network=self\nnetwork=lanywhere-public\n"),std::string(512,'x'),std::string("network=self\n\0tail",18)}){
