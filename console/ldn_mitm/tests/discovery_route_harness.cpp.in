namespace os {
 using SdkMutex=std::mutex;
 struct Span {s64 ms; s64 GetMilliSeconds()const{return ms;}};
 struct Tick {s64 ms; Span ToTimeSpan()const{return {ms};}};
 inline Tick operator-(Tick a,Tick b){return {a.ms-b.ms};}
 inline Tick GetSystemTick(){return {std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count()};}
 inline void GenerateRandomBytes(void *p,size_t n){std::memset(p,0,n);}
}
namespace util {
 inline void Strlcpy(char *out,const char *in,size_t n){if(n){const size_t len=std::min(n-1,std::strlen(in));std::memcpy(out,in,len);out[len]=0;}}
 template<class...A>int SNPrintf(char *p,size_t n,const char *fmt,A...a){return std::snprintf(p,n,fmt,a...);}
}
namespace fs {
 struct Data {std::string value;};using FileHandle=std::shared_ptr<Data>;
 enum {OpenMode_Read=1,OpenMode_Write=2,OpenMode_AllowAppend=4};
 enum class WriteOption {Flush};
 struct ResultPathNotFound {static bool Includes(Result r){return r==2;}};
 static std::unordered_map<std::string,std::shared_ptr<Data>> files;
 static int read_opens=0,writes=0,creates=0;static bool denied=false,fail_size=false,short_read=false;
 Result OpenFile(FileHandle *out,const char *path,int mode){if(mode==OpenMode_Read)read_opens++;if(denied)return 9;auto i=files.find(path);if(i==files.end())return 2;*out=i->second;return 0;}
 Result GetFileSize(s64 *n,FileHandle f){if(fail_size)return 9;*n=f->value.size();return 0;}
 Result ReadFile(size_t *got,FileHandle f,s64 off,void *out,size_t n){if(off<0||size_t(off)>f->value.size())return 9;n=std::min(n,f->value.size()-size_t(off));if(short_read&&n)n--;std::memcpy(out,f->value.data()+off,n);*got=n;return 0;}
 void CloseFile(FileHandle &f){f.reset();}
 Result CreateDirectory(const char*){return 0;}
 Result CreateFile(const char *path,size_t){creates++;files[path]=std::make_shared<Data>();return 0;}
 Result WriteFile(FileHandle f,s64 off,const void *p,size_t n,WriteOption){writes++;if(off<0)return 9;if(size_t(off)+n>f->value.size())f->value.resize(size_t(off)+n);std::memcpy(&f->value[size_t(off)],p,n);return 0;}
}
