struct SfBufferAttrs{u32 attr0=0,attr1=0,attr2=0,attr3=0,attr4=0,attr5=0,attr6=0,attr7=0;};struct SfBuffer{const void *ptr;size_t size;};
struct SfDispatchParams{SfBufferAttrs buffer_attrs{};SfBuffer buffers[8]{};};
constexpr u32 SfBufferAttr_HipcAutoSelect=32,SfBufferAttr_In=1,SfBufferAttr_Out=2,SfBufferAttr_HipcMapAlias=4;
static u32 serviceDispatchImpl(Service *service,u32 command,const void *in,u32 in_size,void *out,u32 out_size,SfDispatchParams params){
 u32 attrs[8];std::memcpy(attrs,&params.buffer_attrs,sizeof(attrs));tcpstream::IpcBuffer buffers[8]{};size_t n=0;for(size_t i=0;i<8;i++)if(attrs[i]){assert(i==n++);assert((attrs[i]&32)||(attrs[i]&4));buffers[i]={const_cast<void*>(params.buffers[i].ptr),params.buffers[i].size,(attrs[i]&2)!=0};}return GameNamespace::Dispatch(service->game,command,in,in_size,out,out_size,buffers,n);
}
