 tcpstream::selected=&pa;assert(aa->DuplicateSocket({&ret},{&error},{client,0,0})==0&&ret>=1000);const int duplicate=ret;assert(aa->Close({&ret},{&error},client)==0&&ret==0);
 assert(pa.GetStatus(oa,duplicate).state==tcpstream::State::Connected);s32 exemption=1;const int sets_before=ga.command_count[21];assert(aa->SetSockOpt({&ret},{&error},duplicate,0xffff,0x10000,{reinterpret_cast<const u8*>(&exemption),4})==0&&ret==-1&&error==95&&ga.command_count[21]==sets_before);assert(aa->Write({&ret},{&error},duplicate,{bytes.data(),bytes.size()})==0&&ret==4000);
 tcpstream::selected=&pb;have=0;while(have<got.size()){assert(bb->Read({&ret},{&error},accepted,{got.data()+have,got.size()-have})==0&&ret>0);have+=ret;}assert(got==bytes);
 tcpstream::selected=&pa;const int duplicates_before=ga.command_count[27];assert(aa->DuplicateSocket({&ret},{&error},{duplicate,1,0})==0&&ret==-1&&error==22&&ga.command_count[27]==duplicates_before);
 u8 batch[32]{};assert(aa->RecvMMsg({&ret},{&error},{duplicate,1,0,0,0,0},{batch,sizeof(batch)})==0&&ret==-1&&error==95);assert(aa->SendMMsg({&ret},{&error},{duplicate,1,0},{batch,sizeof(batch)})==0&&ret==-1&&error==95);
 assert(aa->Shutdown({&ret},{&error},duplicate,1)==0&&ret==0);tcpstream::selected=&pb;assert(bb->Read({&ret},{&error},accepted,{got.data(),1})==0&&ret==0);assert(bb->Shutdown({&ret},{&error},accepted,1)==0&&ret==0);
