struct Link {std::mutex lock;tcpstream::Proxy *peer=nullptr;u32 source=0;bool held=false,enabled=true;std::vector<std::vector<u8>> queue;
 static bool Send(void *v,u64 epoch,const u8 *bytes,size_t size){auto &x=*static_cast<Link*>(v);std::scoped_lock guard(x.lock);if(!x.enabled)return false;std::vector<u8> copy(bytes,bytes+size);tcpstream::Put32(copy.data(),x.source);if(x.held)x.queue.push_back(std::move(copy));else x.peer->OnFrame(epoch,copy.data(),copy.size());return true;}
 void Flush(){std::scoped_lock guard(lock);held=false;for(const auto &b:queue)peer->OnFrame(1,b.data(),b.size());queue.clear();}
 void Disable(){std::scoped_lock guard(lock);enabled=false;}
};
static void Until(const std::function<bool()> &f,const char *name){const auto end=std::chrono::steady_clock::now()+std::chrono::seconds(5);while(std::chrono::steady_clock::now()<end){if(f())return;std::this_thread::sleep_for(std::chrono::milliseconds(1));}std::cerr<<name<<'\n';std::abort();}
int main(){
 using namespace ams;
 const std::pair<u64,bool> boundaries[]={{0,false},{0x010000000000100D,false},{0x010000000000FFFF,false},{0x0100000000010000,true},{0x0100ABCDEF012000,true},{0x0100123400001000,true},{0x01FFFFFFFFFFFFFF,true},{0x0200000000000000,false},{0x0500000012345678,false},{0x4200000000000010,false},{0x420000000007E51A,false}};
 for(const auto &[id,want]:boundaries)assert(BsdSpyService::ShouldMitm(sm::MitmProcessInfo{{777},{id}})==want);
 Link ab,ba;tcpstream::Proxy pa(Link::Send,&ab),pb(Link::Send,&ba);ab.peer=&pb;ba.peer=&pa;ab.source=0x0a0d0101;ba.source=0x0a0d0202;ba.held=true;
 tcpstream::Owner oa{101,0x0100000000011111},ob{202,0x0100000000022222};tcpstream::GameSession sa{},sb{};sa.owner=oa;sa.transport_epoch=1;sa.session_nonce=111;sa.binding_id=1;sa.capabilities=128;sa.self_ip=ab.source;sa.peers[0]=ba.source;sa.network_id[0]=42;sa.active=true;sb=sa;sb.owner=ob;sb.self_ip=ba.source;sb.peers[0]=ab.source;sb.session_nonce=222;sb.binding_id=2;pa.SetSession(sa);pb.SetSession(sb);
 GameNamespace ga,gb;tcpstream::Forward fa(&ga,GameNamespace::Dispatch),fb(&gb,GameNamespace::Dispatch);
 tcpstream::selected=&pa;auto aa=std::make_unique<BsdSpyService>(std::make_shared<Service>(Service{&ga}),sm::MitmProcessInfo{{oa.process},{oa.program}});
 tcpstream::selected=&pb;auto bb=std::make_unique<BsdSpyService>(std::make_shared<Service>(Service{&gb}),sm::MitmProcessInfo{{ob.process},{ob.program}});
 const int listen=fb.Socket().ret;assert(listen>=1000&&pb.SocketCreated(ob,listen,1));assert(fb.Bind(listen,{0,0}).ret==0);tcpstream::Endpoint local{};assert(fb.Name(listen,&local).ret==0);const int32_t listen_args[2]={listen,4};assert(fb.Call(18,listen_args,sizeof(listen_args)).ret==0);pb.Bound(ob,listen,{0,local.port});pb.Listening(ob,listen,4);const int32_t timeopt[3]={listen,0xffff,0x1006};int64_t timevalue[2]={0,300000};tcpstream::IpcBuffer timebuffer{timevalue,16,false};assert(fb.Call(21,timeopt,12,&timebuffer,1).ret==0);
 const int client=fa.Socket().ret;assert(client>=1000&&pa.SocketCreated(oa,client,1));int32_t flags[3]={client,4,0x800};assert(fa.Call(20,flags,sizeof(flags)).ret==0);
 auto destination=tcpstream::MakeAddress({sb.self_ip,local.port});s32 ret=0,error=0;u32 length=0;tcpstream::selected=&pa;
 assert(aa->Connect({&ret},{&error},client,{destination.bytes,16})==0&&ret==-1&&error==115);
 Until([&]{return pb.PendingAccept(ob,listen);},"remote backlog");
 tcpstream::NativePollFd poll_in{client,4,0},poll_out{};
 assert(aa->Poll({&ret},{&error},1,0,{reinterpret_cast<const u8*>(&poll_in),8},{reinterpret_cast<u8*>(&poll_out),8})==0&&ret==0&&!(poll_out.revents&4));
 u8 writes[128]{},writes_out[128]{};writes[client/8]|=1<<(client%8);tcpstream::NativeSelectData selection{};selection.nfds=client+1;selection.padding=0xaaaaaaaa;selection.reserved[0]=0xbb; // actual C ABI padding is ignored.
 assert(aa->Select({&ret},{&error},selection,{nullptr,0},{writes,128},{nullptr,0},{nullptr,0},{writes_out,128},{nullptr,0})==0&&ret==0&&!(writes_out[client/8]&(1<<(client%8))));
 u8 address[16]{};assert(aa->GetPeerName({&ret},{&error},{&length},client,{address,16})==0&&ret==-1&&error==107);
 assert(aa->GetSockName({&ret},{&error},{&length},client,{address,16})==0&&ret==0&&length==16);tcpstream::Endpoint virtual_local{};assert(tcpstream::ReadAddress(address,16,&virtual_local)&&virtual_local.ip==sa.self_ip);
 // Accept executes real game-namespace Socket/Bind/Connect commands, not module fd operations.
 tcpstream::selected=&pb;u8 short_addr[8]{};assert(bb->Accept({&ret},{&error},{&length},listen,{short_addr,8})==0&&ret>=1000&&length==16);const int accepted=ret;assert(gb.command_count[2]==2&&gb.command_count[14]==1);int64_t inherited_timeout=0;assert(fb.Timeout(accepted,false,&inherited_timeout).ret==0&&inherited_timeout==300);
 ba.Flush();Until([&]{return pa.GetStatus(oa,client).state==tcpstream::State::Connected;},"OPEN completion");tcpstream::selected=&pa;
 assert(aa->Poll({&ret},{&error},1,0,{reinterpret_cast<const u8*>(&poll_in),8},{reinterpret_cast<u8*>(&poll_out),8})==0&&ret==1&&(poll_out.revents&4));
 assert(aa->Select({&ret},{&error},selection,{nullptr,0},{writes,128},{nullptr,0},{nullptr,0},{writes_out,128},{nullptr,0})==0&&ret==1&&(writes_out[client/8]&(1<<(client%8))));
 assert(aa->GetPeerName({&ret},{&error},{&length},client,{address,16})==0&&ret==0);tcpstream::Endpoint virtual_peer{};assert(tcpstream::ReadAddress(address,16,&virtual_peer)&&virtual_peer.ip==sb.self_ip&&virtual_peer.port==local.port);
 tcpstream::Endpoint physical_peer{};assert(fa.Name(client,&physical_peer,true).ret==0&&physical_peer.ip==0x7f000001);
