static int NativeError(){switch(errno){case EAGAIN:return 11;case EINPROGRESS:return 115;case EALREADY:return 114;case EISCONN:return 106;case ENOTCONN:return 107;case ECONNRESET:return 104;case ECONNREFUSED:return 111;case ETIMEDOUT:return 110;case EBADF:return 9;default:return 22;}}
struct GameNamespace {
 std::map<int,int> sockets;int next=1000,virtual_connects=0,command_count[32]{};
 ~GameNamespace(){for(auto [id,fd]:sockets){(void)id;::close(fd);}}
 int Real(int id){auto it=sockets.find(id);if(it==sockets.end()){errno=EBADF;return -1;}return it->second;}
 static u32 Dispatch(void *ctx,u32 command,const void *input,size_t input_size,void *output,size_t output_size,const tcpstream::IpcBuffer *buffers,size_t count){
  auto &self=*static_cast<GameNamespace*>(ctx);assert(command<32);self.command_count[command]++;
  struct Raw{int32_t ret,error;uint32_t length;} out{-1,0,0};assert(output_size==8||output_size==12);
  const auto *ints=static_cast<const int32_t*>(input);const int id=input_size>=4?ints[0]:-1;const int fd=(command==2||command==3||command==5||command==6||command==23)?-1:self.Real(id);
  auto endpoint=[&](size_t index){tcpstream::Endpoint e{};assert(index<count&&buffers[index].size>=16&&tcpstream::ReadAddress(buffers[index].data,16,&e));return e;};
  switch(command){
   case 2:case 3:{assert(input_size==12&&count==0&&ints[0]==2&&ints[1]==1);const int real=::socket(AF_INET,SOCK_STREAM,0);assert(real>=0);int one=1;
#ifdef SO_NOSIGPIPE
    ::setsockopt(real,SOL_SOCKET,SO_NOSIGPIPE,&one,sizeof(one));
#endif
    (void)one;out.ret=self.next++;self.sockets[out.ret]=real;break;}
   case 12:{assert(input_size==4&&count==1&&buffers[0].output);sockaddr_in a{};socklen_t n=sizeof(a);const int real=::accept(fd,reinterpret_cast<sockaddr*>(&a),&n);if(real>=0){out.ret=self.next++;self.sockets[out.ret]=real;auto raw=tcpstream::MakeAddress({ntohl(a.sin_addr.s_addr),ntohs(a.sin_port)});std::memcpy(buffers[0].data,&raw,std::min(buffers[0].size,sizeof(raw)));out.length=16;}break;}
   case 13:case 14:{assert(input_size==4&&count==1&&!buffers[0].output);const auto e=endpoint(0);if(command==14&&(e.ip>>16)==0x0a0d)self.virtual_connects++;sockaddr_in a{};a.sin_family=AF_INET;a.sin_addr.s_addr=htonl(e.ip);a.sin_port=htons(e.port);out.ret=command==13?::bind(fd,reinterpret_cast<sockaddr*>(&a),sizeof(a)) : ::connect(fd,reinterpret_cast<sockaddr*>(&a),sizeof(a));break;}
   case 15:case 16:{assert(input_size==4&&output_size==12&&count==1&&buffers[0].output);sockaddr_in a{};socklen_t n=sizeof(a);out.ret=command==15?::getpeername(fd,reinterpret_cast<sockaddr*>(&a),&n): ::getsockname(fd,reinterpret_cast<sockaddr*>(&a),&n);if(out.ret==0){auto raw=tcpstream::MakeAddress({ntohl(a.sin_addr.s_addr),ntohs(a.sin_port)});std::memcpy(buffers[0].data,&raw,std::min(buffers[0].size,sizeof(raw)));out.length=16;}break;}
   case 17:{assert(input_size==12&&output_size==12&&count==1&&buffers[0].output&&ints[1]==0xffff);if(ints[2]==0x1008){int value=0;socklen_t n=sizeof(value);out.ret=::getsockopt(fd,SOL_SOCKET,SO_TYPE,&value,&n);std::memcpy(buffers[0].data,&value,4);out.length=4;}else if(ints[2]==0x1005||ints[2]==0x1006){assert(buffers[0].size==16);timeval t{};socklen_t n=sizeof(t);out.ret=::getsockopt(fd,SOL_SOCKET,ints[2]==0x1005?SO_SNDTIMEO:SO_RCVTIMEO,&t,&n);const int64_t values[2]={t.tv_sec,t.tv_usec};std::memcpy(buffers[0].data,values,16);out.length=16;}else {out.ret=-1;errno=EINVAL;}break;}
   case 18:assert(input_size==8);out.ret=::listen(fd,ints[1]);break;
   case 20:{assert(input_size==12);if(ints[1]==3){const int f=::fcntl(fd,F_GETFL);out.ret=f<0?-1:((f&O_NONBLOCK)?0x800:0);}else if(ints[1]==4){const int f=::fcntl(fd,F_GETFL);out.ret=::fcntl(fd,F_SETFL,(f&~O_NONBLOCK)|((ints[2]&0x800)?O_NONBLOCK:0));}else if(ints[1]==0){const int real=::dup(fd);if(real>=0){out.ret=self.next++;self.sockets[out.ret]=real;}}else{out.ret=-1;errno=EINVAL;}break;}
   case 21:{assert(input_size==12&&count==1&&!buffers[0].output&&ints[1]==0xffff);if(ints[2]==0x1005||ints[2]==0x1006){assert(buffers[0].size==16);const auto *v=static_cast<const int64_t*>(buffers[0].data);timeval t{static_cast<time_t>(v[0]),static_cast<suseconds_t>(v[1])};out.ret=::setsockopt(fd,SOL_SOCKET,ints[2]==0x1005?SO_SNDTIMEO:SO_RCVTIMEO,&t,sizeof(t));}else if(ints[2]==0x10000)out.ret=0;else{errno=EINVAL;out.ret=-1;}break;}
   case 22:assert(input_size==8);out.ret=::shutdown(fd,ints[1]);break;
   case 23:assert(input_size==4);for(auto [key,value]:self.sockets){(void)key;::shutdown(value,ints[0]);}out.ret=0;break;
   case 29:case 30:assert(false);break;
   case 24:{assert(input_size==4&&count==1&&!buffers[0].output);
#ifdef MSG_NOSIGNAL
    out.ret=::send(fd,buffers[0].data,buffers[0].size,MSG_NOSIGNAL);
#else
    out.ret=::send(fd,buffers[0].data,buffers[0].size,0);
#endif
    break;}
   case 25:assert(input_size==4&&count==1&&buffers[0].output);out.ret=::recv(fd,buffers[0].data,buffers[0].size,0);break;
   case 26:assert(input_size==4);out.ret=::close(fd);if(out.ret==0)self.sockets.erase(id);break;
   case 27:{assert(input_size==16);const auto *d=static_cast<const tcpstream::NativeDuplicateData*>(input);assert(!d->padding&&!d->reserved);const int real=::dup(fd);if(real>=0){out.ret=self.next++;self.sockets[out.ret]=real;}break;}
   case 6:{assert(input_size==8&&count==2&&!buffers[0].output&&buffers[1].output);const size_t n=*static_cast<const uint32_t*>(input);assert(n<=64&&buffers[0].size==n*8&&buffers[1].size==n*8);const auto *in=static_cast<const tcpstream::NativePollFd*>(buffers[0].data);auto *result=static_cast<tcpstream::NativePollFd*>(buffers[1].data);pollfd host[64]{};for(size_t i=0;i<n;i++)host[i]={self.Real(in[i].fd),in[i].events,0};out.ret=::poll(host,n,ints[1]);for(size_t i=0;i<n;i++)result[i]={in[i].fd,in[i].events,host[i].revents};break;}
   case 5:{assert(input_size==32&&count==6);const auto &d=*static_cast<const tcpstream::NativeSelectData*>(input);fd_set sets[3];for(auto &s:sets)FD_ZERO(&s);int maximum=0;for(int n=0;n<d.nfds;n++)for(int k=0;k<3;k++)if(buffers[k].size&&(static_cast<const uint8_t*>(buffers[k].data)[n/8]&(1<<(n%8)))){const int real=self.Real(n);assert(real>=0);FD_SET(real,&sets[k]);maximum=std::max(maximum,real+1);}timeval t{static_cast<time_t>(d.seconds),static_cast<suseconds_t>(d.microseconds)};out.ret=::select(maximum,&sets[0],&sets[1],&sets[2],d.null_timeout?nullptr:&t);for(int k=0;k<3;k++){if(buffers[k+3].size)std::memset(buffers[k+3].data,0,buffers[k+3].size);for(int n=0;n<d.nfds;n++)if(buffers[k].size&&(static_cast<const uint8_t*>(buffers[k].data)[n/8]&(1<<(n%8)))&&FD_ISSET(self.Real(n),&sets[k]))static_cast<uint8_t*>(buffers[k+3].data)[n/8]|=1<<(n%8);}break;}
   default:assert(false);
  }
  if(out.ret<0)out.error=NativeError();
  std::memcpy(output,&out,output_size);return 0;
 }
};
