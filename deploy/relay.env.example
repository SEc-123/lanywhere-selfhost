# Decimal gigabytes of monthly outbound traffic. Set this to suit your VPS plan.
LANYWHERE_CAP_GB=100

# Conservative starting point for a small VPS shared with another service.
# These are connection limits, not a guarantee of simultaneous game capacity.
LANYWHERE_MAX_CONNECTIONS=256
LANYWHERE_MAX_CONNECTIONS_PER_IP=16

# For Switch consoles only, leave the optional Ryujinx LAN Play bridge disabled.
# To enable it, set this to 11451 and separately allow 11451/UDP in your firewall.
LANYWHERE_LANPLAY_PORT=0

# On stop, wait up to 10 seconds for active rooms to finish.
LANYWHERE_SHUTDOWN_GRACE_MS=10000

# A public-room guest must be confirmed by its game host within this deadline.
# Allowed range: 100..120000 ms. PING does not prolong an incomplete game join.
LANYWHERE_JOIN_TIMEOUT_MS=10000

# New rooms per public source IP per minute (1..1000). Keep the conservative default.
LANYWHERE_CREATE_PER_MIN=10

# Local IPv4 interface used for UDP replies. 0.0.0.0 keeps normal route selection.
# On a multihomed/NAT server, set an actual LOCAL interface address, not an
# unassigned public NAT address. The installer checks this on the target host.
LANYWHERE_UDP_BIND_ADDRESS=0.0.0.0

# Local HTTP drain is disabled until you add a private token. Generate one with:
# node -p 'require("node:crypto").randomBytes(32).toString("base64url")'
# LANYWHERE_OPS_TOKEN=generated_token_here

# Optional, fixed-destination communities. Players select a name, never an address.
LANYWHERE_ENABLE_PUBLIC_UPSTREAM=0
LANYWHERE_ENABLE_LANPLAY_UPSTREAM=0
# A subset may be enabled. Each community remains isolated; no automatic migration.
LANYWHERE_LANPLAY_PROVIDERS=lanplay-nl,lanplay-br,lanplay-id,lanplay-nl-jaysea-rust,lanplay-nl-r3ps4j-rust,lanplay-nl-r3ps4j-11452,lanplay-de-servegame
