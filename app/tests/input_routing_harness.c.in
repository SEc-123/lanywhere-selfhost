#define ListConnecting (-1)
#define ListUnavailable (-2)
#define HidNpadButton_AnyDown (1ULL << 15)
#define HidNpadButton_AnyUp (1ULL << 14)
#define HidNpadButton_AnyLeft (1ULL << 16)
#define HidNpadButton_AnyRight (HidNpadButton_Right | (1ULL << 17))
#define TOUCH_CARD (1ULL << 62)
#define TOUCH_NETWORK_CHOICE (1ULL << 61)
